---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
// maybe do pagination at some point if there are too many stories at once

// first we need to sort the collection object by date
// https://docs.astro.build/en/guides/content-collections/#querying-build-time-collections
const storyArray = (await getCollection("stories")).sort(
  (a,b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="All Stories | Stu's News" header="All Stories")>
  <ul>
    {storyArray.map((story) => 
      <li class="m-8">
        <a
          href={`/stories/${story.id}`}
          class="flex flex-row gap-4 items-center custom-shadow p-4 hover:bg-brown/30"
        >
          <img
            src={story.data.image.url}
            class="aspect-square w-60 object-cover border-2 border-beige"
          />
          <div class="flex flex-col gap-2">
            <h2 class="text-2xl max-w-100">{story.data.title}</h2>
            <p class="text-brown/90">{story.data.date.toString().slice(0,15)}</p>
            <p>FIX THE DATES LATER</p>
          </div>
        </a>
      </li>
    )}
  </ul>
</BaseLayout>
