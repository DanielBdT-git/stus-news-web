---
const {name, role, image} = Astro.props;
---

<article class="flex flex-row items-center gap-6 p-4 text-brown custom-shadow w-[40vw]">
  <img
    src={`/members/${image || "unknown.webp"}`}
    alt={name}
    class="aspect-square object-cover h-40 outline border-brown"
  />
  <div class="flex flex-col items-start">
    {name === "Nicholas Kadyk" && <svg xmlns="http://www.w3.org/2000/svg" class="fill-brown w-8" viewBox="0 0 256 256"><path d="M248,80a28,28,0,1,0-51.12,15.77l-26.79,33L146,73.4a28,28,0,1,0-36.06,0L85.91,128.74l-26.79-33a28,28,0,1,0-26.6,12L47,194.63A16,16,0,0,0,62.78,208H193.22A16,16,0,0,0,209,194.63l14.47-86.85A28,28,0,0,0,248,80ZM128,40a12,12,0,1,1-12,12A12,12,0,0,1,128,40ZM24,80A12,12,0,1,1,36,92,12,12,0,0,1,24,80ZM193.22,192H62.78L48.86,108.52,81.79,149A8,8,0,0,0,88,152a7.83,7.83,0,0,0,1.08-.07,8,8,0,0,0,6.26-4.74l29.3-67.4a27,27,0,0,0,6.72,0l29.3,67.4a8,8,0,0,0,6.26,4.74A7.83,7.83,0,0,0,168,152a8,8,0,0,0,6.21-3l32.93-40.52ZM220,92a12,12,0,1,1,12-12A12,12,0,0,1,220,92Z"></path></svg>}
    <span class="text-2xl font-bold">{name}</span>
    <span class="text-lg">{role}</span>
  </div>
</article>

<style>
  .custom-shadow {
    box-shadow: 4px 4px var(--brown);
    border: 2px solid var(--brown)
  }
</style>