---
const {name, role, image, icon} = Astro.props;
---

<article class="flex flex-row items-center gap-6 p-4 text-brown custom-shadow">
  <img
    src={`/members/${image || "unknown.webp"}`}
    alt={name}
    class="aspect-square object-cover h-40 outline border-brown"
  />
  <div class="flex flex-col items-start">
    <span class="text-2xl font-bold">{name}</span>
    <div class="flex flex-row items-baseline gap-1">
      {icon && <i class={`ph-duotone ph-${icon} text-xl`}></i>}
      <span class="text-lg">{role}</span>
    </div>
  </div>
</article>

<style>
  .custom-shadow {
    box-shadow: 4px 4px var(--brown);
    border: 2px solid var(--brown)
  }
</style>